# OSIE Docker Compose Environment Configuration

# Public hostname or IP — determines TLS mode automatically:
#   Domain    (e.g. osie.example.com) → Let's Encrypt
#   IP        (e.g. 203.0.113.10)    → self-signed via internal CA
#   localhost                         → self-signed via internal CA
PUBLIC_HOSTNAME=osie.example.com

# ── Secrets ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 | tr -d '/+=' | head -c 32
MONGODB_PASSWORD=osie
RABBITMQ_PASSWORD=osie

# AES-256 encryption key for sensitive data at rest
# Generate with: openssl rand -base64 32
OSIE_ENCRYPTION_KEY=change-me-in-production

# ── Versions ─────────────────────────────────────────────────
OSIE_API_VERSION=latest
OSIE_UI_VERSION=latest
OSIE_ADMIN_VERSION=latest
