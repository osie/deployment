# OSIE Docker Compose Environment Configuration

# Where OSIE is accessible from the outside
# Prod:  https://your-domain.com
# Dev:   https://203.0.113.10  (or http://203.0.113.10:8080)
EXTERNAL_BASE_URL=https://203.0.113.10

# ── Prod mode only ───────────────────────────────────────────
# Domain for Caddy to obtain a Let's Encrypt certificate
CADDY_DOMAIN=your-domain.com

# ── Dev mode only ────────────────────────────────────────────
# Ports Docker maps to Caddy's internal :80 and :443
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ── Secrets ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32 | tr -d '/+=' | head -c 32
MONGODB_PASSWORD=osie
RABBITMQ_PASSWORD=osie

# AES-256 encryption key for sensitive data at rest
# Generate with: openssl rand -base64 32
OSIE_ENCRYPTION_KEY=change-me-in-production

# ── Versions ─────────────────────────────────────────────────
OSIE_API_VERSION=latest
OSIE_UI_VERSION=latest
OSIE_ADMIN_VERSION=latest
